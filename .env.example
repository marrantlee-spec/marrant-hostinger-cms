# Inquiry emails are delivered by FormSubmit. The recipient address is kept in
# app/api/inquiries/recipient.ts so it is not exposed in client-side code.

# Hostinger MySQL / CMS
DATABASE_URL=mysql://database_user:database_password@database_host:3306/database_name
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-12-character-password

# Vercel Blob (create a Blob store and copy its read/write token)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token
